# QueueBox configuration.
#
# Copy this file to `.env` and change the values. Docker Compose reads it with
# `docker compose --env-file .env.example up`.
#
# QueueBox reads every variable that starts with `QUEUEBOX_`. The name after the prefix is the
# YAML path in upper case, with an underscore for each level. `QUEUEBOX_DATABASE_URL` sets
# `database.url`. An environment variable always wins over a file.
#
# For anything that a flat variable cannot express, write a `queuebox.yml` file and point
# `QUEUEBOX_CONFIG_FILE` at it. The default external path is `/etc/queuebox/queuebox.yml`.

# --- Required ---------------------------------------------------------------

QUEUEBOX_DATABASE_URL=jdbc:postgresql://postgres:5432/queuebox
QUEUEBOX_DATABASE_USERNAME=queuebox
QUEUEBOX_DATABASE_PASSWORD=queuebox

# --- Server -----------------------------------------------------------------

QUEUEBOX_SERVER_HTTPPORT=8080

# --- Outbox -----------------------------------------------------------------

QUEUEBOX_OUTBOX_POLLINTERVALMS=100
QUEUEBOX_OUTBOX_BATCHSIZE=100
QUEUEBOX_OUTBOX_MAXATTEMPTS=5

# --- The configuration file -------------------------------------------------

QUEUEBOX_CONFIG_FILE=/etc/queuebox/queuebox.yml

# A destination, a route and a source are nested structures. Write them in the file that
# `QUEUEBOX_CONFIG_FILE` names. `examples/queuebox.yml` is the file this repository mounts, and
# the three blocks below are copied from it.
#
# destinations:
#   webhook-api:
#     type: http
#     baseUrl: https://api.example.com
#     path: /webhook
#     timeoutMs: 30000
#
# routes:
#   - topicPattern: "order.*"
#     destination: webhook-api
#
# sources:
#   stripe:
#     path: /stripe
#     idempotencyKeyPath: $.id
#     eventTypePath: $.type
