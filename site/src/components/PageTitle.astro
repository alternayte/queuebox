---
// The page title with a "Copy page" menu: copy or view the page as Markdown, or open it in
// Claude or ChatGPT. The Markdown comes from the .md copy that src/pages/[...slug].md.ts serves.
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { getCollection } from "astro:content";

const route = Astro.locals.starlightRoute;
const id = route.entry.id;
// Only pages of the docs collection have a Markdown copy.
const docIds = new Set((await getCollection("docs")).filter((d) => d.body !== undefined).map((d) => d.id));
const isDoc = docIds.has(id);
const mdPath = `/${id === "index" || id === "" ? "index" : id}.md`;
const mdURL = new URL(mdPath, Astro.site ?? Astro.url).href;
const prompt = encodeURIComponent(`Read ${mdURL} and answer my questions about it.`);
---

<div class="page-title-row">
  <Default />
  {
    isDoc && (
      <details class="copy-page">
        <summary>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              fill="currentColor"
              d="M5 1.5A1.5 1.5 0 0 1 6.5 0h6A1.5 1.5 0 0 1 14 1.5v8a1.5 1.5 0 0 1-1.5 1.5h-6A1.5 1.5 0 0 1 5 9.5zm1.5-.5a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h6a.5.5 0 0 0 .5-.5v-8a.5.5 0 0 0-.5-.5zM2 5.5A1.5 1.5 0 0 1 3.5 4H4v1h-.5a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V14h1v.5a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 2 14.5z"
            />
          </svg>
          <span class="label">Copy page</span>
        </summary>
        <div class="menu" role="menu">
          <button type="button" role="menuitem" data-copy-md={mdPath}>
            <strong>Copy as Markdown</strong>
            <span>For a chat or a coding agent</span>
          </button>
          <a role="menuitem" href={mdPath}>
            <strong>View as Markdown</strong>
            <span>The plain text of this page</span>
          </a>
          <a role="menuitem" href={`https://claude.ai/new?q=${prompt}`} target="_blank" rel="noopener">
            <strong>Open in Claude</strong>
            <span>Ask questions about this page</span>
          </a>
          <a role="menuitem" href={`https://chatgpt.com/?hints=search&q=${prompt}`} target="_blank" rel="noopener">
            <strong>Open in ChatGPT</strong>
            <span>Ask questions about this page</span>
          </a>
        </div>
      </details>
    )
  }
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-md]")) {
    btn.addEventListener("click", async () => {
      const label = btn.closest("details")?.querySelector(".label");
      try {
        const res = await fetch(btn.dataset.copyMd!);
        await navigator.clipboard.writeText(await res.text());
        if (label) label.textContent = "Copied";
      } catch {
        if (label) label.textContent = "Copy failed";
      }
      btn.closest("details")?.removeAttribute("open");
      setTimeout(() => label && (label.textContent = "Copy page"), 2000);
    });
  }
  // A click outside the menu closes it.
  document.addEventListener("click", (e) => {
    for (const d of document.querySelectorAll("details.copy-page[open]")) {
      if (!d.contains(e.target as Node)) d.removeAttribute("open");
    }
  });
</script>

<style>
  .page-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .copy-page {
    position: relative;
    flex-shrink: 0;
    margin-top: 1.4rem;
  }
  .copy-page summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-control, 8px);
    background: var(--sl-color-black);
    box-shadow: var(--shadow-panel);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      color 120ms;
  }
  .copy-page summary::-webkit-details-marker {
    display: none;
  }
  .copy-page summary:hover {
    color: var(--sl-color-white);
  }
  .copy-page summary:active {
    transform: scale(0.97);
  }
  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 10;
    width: 16rem;
    padding: 0.3rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--radius-panel, 12px);
    background: var(--sl-color-black);
    box-shadow:
      0 4px 12px -2px rgb(0 0 0 / 20%),
      0 16px 40px -8px rgb(0 0 0 / 30%);
    animation: pop 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(-2px);
    }
  }
  .menu :is(a, button) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: 0;
    border-radius: var(--radius-control, 8px);
    background: none;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .menu :is(a, button):hover,
  .menu :is(a, button):focus-visible {
    background: var(--sl-color-accent);
    color: #fff;
  }
  .menu :is(a, button):hover span,
  .menu :is(a, button):focus-visible span {
    color: rgb(255 255 255 / 80%);
  }
  .menu strong {
    font-weight: 500;
  }
  .menu span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }
  @media (max-width: 40rem) {
    .copy-page .label {
      display: none;
    }
  }
</style>
