# F-066: one formatting contract for every editor and for ktlint.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{kt,kts}]
# The `ktlint_official` style rewrites almost every file. `intellij_idea` matches the official
# Kotlin coding conventions, which CONTRIBUTING.md already names as the standard of the project.
ktlint_code_style = intellij_idea
# The Ktor routing DSL and the Exposed SQL DSL are designed around a wildcard import.
# The detekt rule `WildcardImport` is disabled for the same reason.
ktlint_standard_no-wildcard-imports = disabled
# The trailing comma rules fight an existing codebase and add churn to every diff.
ktlint_standard_trailing-comma-on-call-site = disabled
ktlint_standard_trailing-comma-on-declaration-site = disabled
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
