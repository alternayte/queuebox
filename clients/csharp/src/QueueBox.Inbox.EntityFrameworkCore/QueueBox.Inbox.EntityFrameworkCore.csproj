<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>QueueBox.Inbox.EntityFrameworkCore</RootNamespace>
    <AssemblyName>QueueBox.Inbox.EntityFrameworkCore</AssemblyName>

    <PackageId>QueueBox.Inbox.EntityFrameworkCore</PackageId>
    <Version>0.1.0</Version>
    <Description>Entity Framework Core helper for QueueBox.Inbox. It builds a context on the transaction of the message, so the application write and the inbox completion commit together.</Description>
    <Authors>AlterNayte</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/alternayte/queuebox</PackageProjectUrl>
    <RepositoryUrl>https://github.com/alternayte/queuebox</RepositoryUrl>
    <PackageTags>queuebox;inbox;outbox;transactional;entityframeworkcore;efcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet shows this file on the package page. Without it the page carries the description
         and nothing else. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The README travels inside the package, so the page on NuGet shows it. -->
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../QueueBox.Inbox/QueueBox.Inbox.csproj" />
  </ItemGroup>

  <!-- The pack process turns a ProjectReference into a package dependency with a minimum-version
       range by default. That range lets a consumer resolve a later QueueBox.Inbox than the one
       this package was built against, which is exactly the drift the lockstep release forbids.
       This target rewrites that range to an exact match on the version the tag names, right
       before the nuspec file is written. `_ProjectReferencesWithVersions` is an undocumented,
       SDK-internal item, so an SDK upgrade can rename or remove it; check this target after any
       SDK bump. -->
  <Target Name="PinCoreDependencyToExactVersion" AfterTargets="_GetProjectReferenceVersions" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'QueueBox.Inbox'">
        <ProjectVersion>[%(_ProjectReferencesWithVersions.ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The helper needs the relational abstractions alone. The caller adds the provider package
         that its build delegate uses. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
  </ItemGroup>

</Project>
